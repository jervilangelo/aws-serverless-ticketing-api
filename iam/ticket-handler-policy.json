{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TicketsTableCrud",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:<ACCOUNT_ID>:table/HrisTickets"
    },
    {
      "Sid": "TicketsStatusIndexQuery",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:dynamodb:ap-southeast-1:<ACCOUNT_ID>:table/HrisTickets/index/status-index"
    }
  ]
}
