{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTicketsStream",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator",
        "dynamodb:DescribeStream",
        "dynamodb:ListStreams"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:<ACCOUNT_ID>:table/HrisTickets/stream/*"
    },
    {
      "Sid": "PublishCriticalAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-southeast-1:<ACCOUNT_ID>:hris-critical-alerts"
    }
  ]
}
